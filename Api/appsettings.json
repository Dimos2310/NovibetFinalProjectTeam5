{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": "Server=(localdb)\\MSSQLLocalDB;Database=NovibetIpDb;Trusted_Connection=True;MultipleActiveResultSets=true"
  },
  "Ip2C": {
    "BaseUrl": "https://ip2c.org/"
  },
  "Cache": {
    "TtlMinutes": 60
  },
  "IpUpdateJob": {
    "IntervalHours": 1,
    "BatchSize": 100
  }
}
